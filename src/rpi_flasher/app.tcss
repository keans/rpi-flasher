/* A compact card-based wizard that remains usable in small terminals. */

Screen {
    background: $surface;
}

Header {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
}

Footer {
    background: $surface-darken-1;
    color: $text-muted;
}

#disk-select-body, #image-select-body, #options-body,
#overview-body, #flash-progress-body,
#device-select-body, #os-select-body, #wlan-details-body {
    /* width: auto shrink-wraps to the narrowest child instead of filling
       the screen -- badly, and inconsistently, once a wrapping Static's
       intrinsic width gets involved (collapsed some screens to a handful
       of columns). 1fr fills the available width like the card is meant
       to. */
    width: 1fr;
    height: 1fr;
    margin: 1 2;
    padding: 1 2;
    background: $panel;
    border: round $primary-darken-1;
    overflow-y: auto;
}

#title {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
    margin-bottom: 1;
    color: $accent;
    text-style: bold;
    border-bottom: solid $primary-darken-2;
}

.hint {
    height: auto;
    margin-bottom: 1;
    color: $text-muted;
}

#status, #empty-state, #no-matches, #detail, #speed, #result,
#validation-error, #warnings, #summary, #dialog-prompt, #phase-label {
    height: auto;
}

#status, #speed {
    min-height: 1;
    margin-bottom: 1;
    color: $text-muted;
}

#empty-state, #no-matches {
    margin: 1 0;
    padding: 1 2;
    background: $warning 10%;
    border-left: thick $warning;
    color: $warning-lighten-2;
}

#validation-error, #warnings, #result.error {
    margin-top: 1;
    padding: 1 2;
    background: $error 12%;
    border-left: thick $error;
    color: $error-lighten-2;
}

#result.success {
    margin-top: 1;
    padding: 1 2;
    background: $success 12%;
    border-left: thick $success;
    color: $success-lighten-2;
}

#detail {
    min-height: 2;
    margin-top: 1;
    padding: 0 1;
    color: $text-muted;
}

#disk-table, #image-list, #device-list, #os-list {
    height: 1fr;
    min-height: 6;
    /* No border by default -- the surrounding card already frames the
       screen, and the background swap from $panel to $surface sets the
       list apart without a second nested box. But with no border AND the
       highlighted row styled the same whether focused or not, there was
       no visual cue at all that the list actually had keyboard focus --
       add one back only for the focused state. */
    background: $surface;
    border: tall transparent;
}

#disk-table:focus, #image-list:focus, #device-list:focus, #os-list:focus {
    border: tall $accent;
}

DataTable > .datatable--header {
    background: $primary-darken-2;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--cursor,
OptionList > .option-list--option-highlighted {
    background: $primary;
    color: $text;
    text-style: bold;
}

/* Textual's default Button:focus is just a subtle 5% background tint --
   easy to miss against our colored primary/error variants, which made
   a pre-focused button look unfocused until Tab visibly moved it. A
   border would be the obvious fix, but our buttons are all compact=True
   (border: none !important, to stay a single row), and author-stylesheet
   rules override that !important regardless of specificity -- a border
   here would silently balloon every focused button back to 3 rows. Use
   a reverse/bold text style instead, which doesn't consume extra space. */
Button:focus {
    text-style: bold reverse;
}

/* compact=True (set on every Input we use) forces `border: none
   !important` in Textual's own CSS regardless of focus state, so a
   border-based focus indicator here would never actually show -- the
   text cursor itself is enough to show which field is active. */
Input {
    margin-bottom: 0;
    background: $surface;
}

Checkbox {
    width: 100%;
    height: auto;
    margin-bottom: 0;
    padding: 0 1;
}

Checkbox:focus {
    background: $boost;
}

#next-button {
    /* No dock -- docking anchors to the card's bottom edge regardless of
       how much content is above it, which reads as a button floating
       apart from the fields it applies to. Plain flow keeps it directly
       under the last field, consistently, on every screen that uses it. */
    min-width: 18;
    margin-top: 1;
}

#summary {
    padding: 1 2;
    background: $surface;
}

#flash-progress-buttons {
    width: 100%;
    height: auto;
    padding-top: 1;
}

#flash-progress-buttons Button {
    min-width: 16;
    margin-right: 1;
}

/* Modal confirmation dialog (ConfirmFlashDialog) -- a small, always
   fully-on-screen popup for the final destructive decision, instead of
   yes/no buttons embedded in the (potentially long, scrollable) Overview
   card. */
ConfirmFlashDialog {
    align: center middle;
}

#confirm-dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: round $error;
}

#dialog-prompt {
    color: $warning-lighten-1;
    text-style: bold;
    margin-bottom: 1;
}

#dialog-buttons {
    width: 100%;
    height: auto;
}

#dialog-buttons Button {
    min-width: 16;
    margin-right: 1;
}

#phase-label {
    margin-bottom: 1;
    color: $accent-lighten-1;
    text-style: bold;
}

#progress-bar {
    margin: 1 0;
}

#progress-bar.phase-safe Bar > .bar--bar {
    color: $success;
}

#progress-bar.phase-writing Bar > .bar--bar {
    color: $error;
}
